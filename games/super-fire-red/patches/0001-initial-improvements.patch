+void FieldUseFunc_ExpShare(u8 taskId)
+{
+    static const u8 sText_On[] = _("EXP. SHARE is now ON.\nYour whole team can gain EXP.");
+    static const u8 sText_Off[] = _("EXP. SHARE is now OFF.\nOnly participants gain EXP.");
+    const u8 *message;
+
+    if (!FlagGet(FLAG_EXP_SHARE_UNLOCKED))
+    {
+        PrintNotTheTimeToUseThat(taskId, gTasks[taskId].data[3]);
+        return;
+    }
+
+    if (FlagGet(FLAG_EXP_SHARE_DISABLED))
+    {
+        FlagClear(FLAG_EXP_SHARE_DISABLED);
+        message = sText_On;
+    }
+    else
+    {
+        FlagSet(FLAG_EXP_SHARE_DISABLED);
+        message = sText_Off;
+    }
+    DisplayItemMessageInCurrentContext(taskId, gTasks[taskId].data[3], FONT_NORMAL, message);
+}
