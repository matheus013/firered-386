@ Region pilot, phase 1 (ambient). Generated by scripts/install_pilot_events.py from HNS_modern.
Johto_CherrygroveCity_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Johto_CherrygroveCity_OnTransition
	.byte 0

Johto_CherrygroveCity_OnTransition:
	setworldmapflag FLAG_WORLD_MAP_CHERRYGROVE_CITY
	end

Johto_CherrygroveCity_EventScript_Object1::
	lock
	faceplayer
	goto_if_set FLAG_GOT_JOHTO_MYSTIC_WATER, Johto_CherrygroveCity_EventScript_Object1_After
	msgbox Johto_CherrygroveCity_Text_MysticWaterGuyBefore, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Johto_CherrygroveCity_EventScript_Object1_After
	giveitem ITEM_MYSTIC_WATER
	goto_if_eq VAR_RESULT, FALSE, EventScript_BagIsFull
	setflag FLAG_GOT_JOHTO_MYSTIC_WATER
Johto_CherrygroveCity_EventScript_Object1_After::
	msgbox Johto_CherrygroveCity_Text_MysticWaterGuyAfter, MSGBOX_DEFAULT
	release
	end

