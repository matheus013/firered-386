@ pokeemerald data/text/trainers.inc: Route123_Text_WendyIntro
Hoenn_Route123_Text_WendyIntro::
	.string "Want to determine how strong you are?\n"
	.string "I'll be the test!$"

@ pokeemerald data/text/trainers.inc: Route123_Text_WendyDefeat
