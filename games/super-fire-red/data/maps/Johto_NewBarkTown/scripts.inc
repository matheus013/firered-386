@ Region pilot, phase 1 (ambient). Generated by scripts/install_pilot_events.py from HNS_modern.
Johto_NewBarkTown_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Johto_NewBarkTown_OnTransition
	.byte 0

Johto_NewBarkTown_OnTransition:
	setworldmapflag FLAG_WORLD_MAP_NEW_BARK_TOWN
	end

Johto_NewBarkTown_EventScript_Object0::
	msgbox Johto_NewBarkTown_Text_FatManState3, MSGBOX_NPC
	end

Johto_NewBarkTown_EventScript_Object1::
	msgbox Johto_NewBarkTown_Text_LassState3, MSGBOX_NPC
	end

Johto_NewBarkTown_EventScript_Object2::
	lock
	goto_if_ge VAR_JOHTO_STORY, 3, Johto_NewBarkTown_EventScript_Object2_After
	goto_if_eq VAR_JOHTO_STORY, 2, Johto_NewBarkTown_EventScript_Object2_Battle
	msgbox Johto_NewBarkTown_Text_Silver1, MSGBOX_DEFAULT
	delay 60
	playse SE_PIN
	applymovement VAR_LAST_TALKED, Common_Movement_ExclamationMark
	faceplayer
	waitmovement 0
	msgbox Johto_NewBarkTown_Text_Silver2, MSGBOX_DEFAULT
	release
	end

Johto_NewBarkTown_EventScript_Object2_Battle::
	faceplayer
	msgbox Johto_NewBarkTown_Text_RivalSeen, MSGBOX_DEFAULT
	closemessage
	goto_if_eq VAR_JOHTO_STARTER, 0, Johto_NewBarkTown_EventScript_Object2_VsChikorita
	goto_if_eq VAR_JOHTO_STARTER, 1, Johto_NewBarkTown_EventScript_Object2_VsCyndaquil
	goto Johto_NewBarkTown_EventScript_Object2_VsTotodile
	end

Johto_NewBarkTown_EventScript_Object2_VsChikorita::
	trainerbattle_no_intro TRAINER_BRENDAN, Johto_NewBarkTown_Text_SilverWin
	setvar VAR_JOHTO_STORY, 3
	goto Johto_NewBarkTown_EventScript_Object2_After
	end

Johto_NewBarkTown_EventScript_Object2_VsCyndaquil::
	trainerbattle_no_intro TRAINER_BRENDAN_2, Johto_NewBarkTown_Text_SilverWin
	setvar VAR_JOHTO_STORY, 3
	goto Johto_NewBarkTown_EventScript_Object2_After
	end

Johto_NewBarkTown_EventScript_Object2_VsTotodile::
	trainerbattle_no_intro TRAINER_BRENDAN_3, Johto_NewBarkTown_Text_SilverWin
	setvar VAR_JOHTO_STORY, 3
	goto Johto_NewBarkTown_EventScript_Object2_After
	end

Johto_NewBarkTown_EventScript_Object2_After::
	faceplayer
	msgbox Johto_NewBarkTown_Text_RivalAfter, MSGBOX_DEFAULT
	release
	end

Johto_NewBarkTown_EventScript_Ferry::
	lock
	faceplayer
	msgbox Johto_NewBarkTown_Text_Ferry, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Johto_NewBarkTown_EventScript_Ferry_Stay
	setvar VAR_0x8004, SEAGALLOP_NEW_BARK
	setvar VAR_0x8006, SEAGALLOP_VERMILION_CITY
	goto EventScript_SailToDest
	end

Johto_NewBarkTown_EventScript_Ferry_Stay::
	release
	end

Johto_NewBarkTown_EventScript_Sign0::
	msgbox Johto_NewBarkTown_Text_Sign, MSGBOX_SIGN
	end

Johto_NewBarkTown_EventScript_Sign1::
	msgbox Johto_NewBarkTown_Text_Door, MSGBOX_SIGN
	end

Johto_NewBarkTown_EventScript_Sign3::
	msgbox Johto_NewBarkTown_Text_ElmsHouse, MSGBOX_SIGN
	end

Johto_NewBarkTown_EventScript_Sign4::
	msgbox Johto_NewBarkTown_Text_LabSign, MSGBOX_SIGN
	end

