	.string "Please don't be angry.$"

@ pokeemerald data/text/trainers.inc: Route109_Text_PaulIntro
Hoenn_Route109_Text_PaulIntro::
	.string "PAUL: Well, this is a mood-breaker.\p"
	.string "I wish you wouldn't disturb our\n"
	.string "precious time together.$"

@ pokeemerald data/text/trainers.inc: Route109_Text_PaulDefeated
Hoenn_Route109_Text_PaulDefeated::
