@ pokeemerald data/text/trainers.inc: Route109_Text_PaulNotEnoughPokemon
Hoenn_Route109_Text_PaulNotEnoughPokemon::
	.string "PAUL: We're totally, deeply in love.\n"
	.string "That's why we make our POKéMON battle\l"
	.string "together.$"

@ pokeemerald data/text/trainers.inc: Route109_Text_PaulPostBattle
Hoenn_Route109_Text_PaulPostBattle::
	.string "PAUL: Well, don't tell anyone that\n"
	.string "we're here.\l"
	.string "This is just our private world of two!$"

@ pokeemerald data/maps/Route109/scripts.inc: Route109_Text_ZigzagoonPicksUpLitter
Hoenn_Route109_Text_ZigzagoonPicksUpLitter::
	.string "The water around these parts is clean.\p"
	.string "But, I get my ZIGZAGOON to pick up\n"
	.string "litter from the shoreline at times.\p"
	.string "Dirty water becomes rain and joins our\n"
	.string "rivers, which we drink from…\p"
	.string "If we pollute the sea, it all comes\n"
	.string "back to haunt us eventually.$"

@ pokeemerald data/text/trainers.inc: Route109_Text_HaileyIntro
Hoenn_Route109_Text_HaileyIntro::
	.string "I can't swim, so I'm pretending\n"
	.string "to swim.$"

@ pokeemerald data/text/trainers.inc: Route109_Text_HaileyDefeated
Hoenn_Route109_Text_HaileyDefeated::
