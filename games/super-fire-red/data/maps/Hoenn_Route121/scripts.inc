@ pokeemerald data/maps/Route121/scripts.inc: Route121_Text_AheadLoomsMtPyre
Hoenn_Route121_Text_AheadLoomsMtPyre::
	.string "Ahead looms MT. PYRE…\p"
	.string "It is a natural monument to the spirits \n"
	.string "of departed POKéMON…$"

@ pokeemerald data/text/trainers.inc: Route121_Text_KateIntro
Hoenn_Route121_Text_KateIntro::
	.string "KATE: Together, we're fearless!\n"
	.string "We'll demonstrate how tough we are!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_KateDefeat
Hoenn_Route121_Text_KateDefeat::
	.string "KATE: I blew it in front of my junior\n"
	.string "student partner…$"

@ pokeemerald data/text/trainers.inc: Route121_Text_KateNotEnoughMons
Hoenn_Route121_Text_KateNotEnoughMons::
	.string "KATE: If you've only got one POKéMON,\n"
	.string "we can't battle with you.\p"
	.string "That would be bullying.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_KatePostBattle
Hoenn_Route121_Text_KatePostBattle::
	.string "KATE: When someone's relying on me,\n"
	.string "I get this urge to look cool in front\l"
	.string "of them…$"

@ pokeemerald data/text/trainers.inc: Route121_Text_JoyIntro
Hoenn_Route121_Text_JoyIntro::
	.string "JOY: Together, we're fearless!\n"
	.string "We'll demonstrate how tough we are!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_JoyDefeat
Hoenn_Route121_Text_JoyDefeat::
	.string "JOY: Please forgive me, KATE!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_JoyNotEnoughMons
Hoenn_Route121_Text_JoyNotEnoughMons::
	.string "JOY: You need at least two POKéMON\n"
	.string "if you're going to challenge us!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_JoyPostBattle
Hoenn_Route121_Text_JoyPostBattle::
	.string "JOY: Ehehe, I'll have to train with KATE,\n"
	.string "my senior student partner, again.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_VanessaIntro
Hoenn_Route121_Text_VanessaIntro::
	.string "Will you play with my delightfully\n"
	.string "pretty POKéMON?$"

@ pokeemerald data/text/trainers.inc: Route121_Text_VanessaDefeat
Hoenn_Route121_Text_VanessaDefeat::
	.string "This isn't what I meant!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_VanessaPostBattle
Hoenn_Route121_Text_VanessaPostBattle::
	.string "I'm going to a CONTEST in LILYCOVE.\p"
	.string "My POKéMON should have no problem\n"
	.string "sweeping the MASTER CLASS.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_WalterIntro
Hoenn_Route121_Text_WalterIntro::
	.string "With my POKéMON, I have traveled\n"
	.string "to the world's four corners.\p"
	.string "You might say I have some confidence\n"
	.string "in my abilities.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_WalterDefeat
Hoenn_Route121_Text_WalterDefeat::
	.string "Ah, well played.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_WalterPostBattle
Hoenn_Route121_Text_WalterPostBattle::
	.string "I would like to circle the globe once\n"
	.string "again with my POKéMON.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_TammyIntro
Hoenn_Route121_Text_TammyIntro::
	.string "There are powers beyond our\n"
	.string "understanding in the world…$"

@ pokeemerald data/text/trainers.inc: Route121_Text_TammyDefeat
Hoenn_Route121_Text_TammyDefeat::
	.string "I have lost…$"

@ pokeemerald data/text/trainers.inc: Route121_Text_TammyPostBattle
Hoenn_Route121_Text_TammyPostBattle::
	.string "MT. PYRE…\n"
	.string "There is a mysterious power\l"
	.string "at work there…$"

@ pokeemerald data/text/trainers.inc: Route121_Text_JessicaIntro
Hoenn_Route121_Text_JessicaIntro::
	.string "Stop! Have a good look at my precious\n"
	.string "POKéMON!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_JessicaDefeat
Hoenn_Route121_Text_JessicaDefeat::
	.string "Oh, how dare you!\n"
	.string "Don't take it so seriously!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_JessicaPostBattle
Hoenn_Route121_Text_JessicaPostBattle::
	.string "Maybe I'll go catch more POKéMON at\n"
	.string "the SAFARI.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_CaleIntro
Hoenn_Route121_Text_CaleIntro::
	.string "Can't you see that I have all this\n"
	.string "stuff with me?\p"
	.string "Despite that, you still insist that\n"
	.string "we battle?$"

@ pokeemerald data/text/trainers.inc: Route121_Text_CaleDefeat
Hoenn_Route121_Text_CaleDefeat::
	.string "Of course I lost!\n"
	.string "I'm holding stuff in both hands!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_CalePostBattle
Hoenn_Route121_Text_CalePostBattle::
	.string "I bought too much stuff at\n"
	.string "the LILYCOVE DEPT. STORE.\p"
	.string "It's up the road from here.\n"
	.string "I wish I had a BAG like yours.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_MylesIntro
Hoenn_Route121_Text_MylesIntro::
	.string "There's nothing I love more than\n"
	.string "checking out other people's POKéMON!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_MylesDefeat
Hoenn_Route121_Text_MylesDefeat::
	.string "Super awesome!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_MylesPostBattle
Hoenn_Route121_Text_MylesPostBattle::
	.string "They're great, your POKéMON!\n"
	.string "How do you raise them?$"

@ pokeemerald data/text/trainers.inc: Route121_Text_PatIntro
Hoenn_Route121_Text_PatIntro::
	.string "I want everybody to see the POKéMON\n"
	.string "I've raised!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_PatDefeat
Hoenn_Route121_Text_PatDefeat::
	.string "Wow!\n"
	.string "Spectacular!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_PatPostBattle
Hoenn_Route121_Text_PatPostBattle::
	.string "I raise every POKéMON with the same\n"
	.string "love and care--I don't pick favorites.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_MarcelIntro
Hoenn_Route121_Text_MarcelIntro::
	.string "My POKéMON have never tasted defeat!\n"
	.string "On their next win, I'm entering them\l"
	.string "in CONTESTS.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_MarcelDefeat
Hoenn_Route121_Text_MarcelDefeat::
	.string "Oh, now what happened here?$"

@ pokeemerald data/text/trainers.inc: Route121_Text_MarcelPostBattle
Hoenn_Route121_Text_MarcelPostBattle::
	.string "I may have to train my gang some more\n"
	.string "before entering any CONTEST.$"

@ pokeemerald data/text/trainers.inc: Route121_Text_CristinIntro
Hoenn_Route121_Text_CristinIntro::
	.string "I have this routine.\n"
	.string "Defeat five TRAINERS a day.\l"
	.string "Guess what? You're number five!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_CristinDefeat
Hoenn_Route121_Text_CristinDefeat::
	.string "No!\n"
	.string "You're horrid!$"

@ pokeemerald data/text/trainers.inc: Route121_Text_CristinPostBattle
Hoenn_Route121_Text_CristinPostBattle::
	.string "I didn't expect to lose this easily…\n"
	.string "I'll win next time!$"

