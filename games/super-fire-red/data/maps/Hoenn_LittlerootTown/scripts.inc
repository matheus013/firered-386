@ Region pilot, phase 1 (ambient). Generated by scripts/install_pilot_events.py from pokeemerald.
Hoenn_LittlerootTown_MapScripts::
	.byte 0

Hoenn_LittlerootTown_EventScript_Object0::
	msgbox Hoenn_LittlerootTown_Text_GoodLuckCatchingPokemon, MSGBOX_NPC
	end

Hoenn_LittlerootTown_EventScript_Object1::
	msgbox Hoenn_LittlerootTown_Text_CanUsePCToStoreItems, MSGBOX_NPC
	end

Hoenn_LittlerootTown_EventScript_Object2::
	msgbox Hoenn_LittlerootTown_Text_BirchSpendsDaysInLab, MSGBOX_NPC
	end

Hoenn_LittlerootTown_EventScript_Ferry::
	lock
	faceplayer
	msgbox Hoenn_LittlerootTown_Text_Ferry, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Hoenn_LittlerootTown_EventScript_Ferry_Stay
	setvar VAR_0x8004, SEAGALLOP_LITTLEROOT
	setvar VAR_0x8006, SEAGALLOP_VERMILION_CITY
	goto EventScript_SailToDest
	end

Hoenn_LittlerootTown_EventScript_Ferry_Stay::
	release
	end

Hoenn_LittlerootTown_EventScript_Sign0::
	msgbox Hoenn_LittlerootTown_Text_TownSign, MSGBOX_SIGN
	end

Hoenn_LittlerootTown_EventScript_Sign1::
	msgbox Hoenn_LittlerootTown_Text_ProfBirchsLab, MSGBOX_SIGN
	end

