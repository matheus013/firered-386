diff --git a/data/scripts/training_coach.inc b/data/scripts/training_coach.inc
new file mode 100644
index 0000000..b4f5d3d
--- /dev/null
+++ b/data/scripts/training_coach.inc
@@ -0,0 +1,24 @@
+EventScript_TrainingCoach::
+	lock
+	faceplayer
+	special Training_IsUnlocked
+	goto_if_eq VAR_RESULT, FALSE, EventScript_TrainingCoachLocked
+	msgbox Text_TrainingCoachWelcome
+	closemessage
+	special OpenTrainingMenu
+	waitstate
+	release
+	end
+
+EventScript_TrainingCoachLocked::
+	msgbox Text_TrainingCoachLocked
+	release
+	end
+
+Text_TrainingCoachWelcome::
+	.string "I adjust nature, EVs and IVs\n"
+	.string "for free. Choose your Pokemon.$"
+
+Text_TrainingCoachLocked::
+	.string "Normal: return after the League.\n"
+	.string "Hardcore: training from the start.$"
diff --git a/include/doubles_ai.h b/include/doubles_ai.h
new file mode 100644
index 0000000..4ba2708
--- /dev/null
+++ b/include/doubles_ai.h
@@ -0,0 +1,28 @@
+#ifndef GUARD_DOUBLES_AI_H
+#define GUARD_DOUBLES_AI_H
+
+enum DoublesMoveKind
+{
+    DOUBLES_MOVE_OTHER,
+    DOUBLES_MOVE_HELPING_HAND,
+    DOUBLES_MOVE_SPREAD,
+    DOUBLES_MOVE_SPEED_CONTROL,
+    DOUBLES_MOVE_SCREEN,
+    DOUBLES_MOVE_WEATHER,
+    DOUBLES_MOVE_FRIENDLY_FIRE,
+};
+
+// Only the AI's own partner and publicly visible battle state are inputs.
+struct DoublesAIContext
+{
+    unsigned char partnerAlive;
+    unsigned char partnerCanAttack;
+    unsigned char twoOpponents;
+    unsigned char effectUseful;
+    unsigned char effectAlreadyActive;
+    unsigned char partnerImmune;
+};
+
+int DoublesAI_AdjustScore(int score, enum DoublesMoveKind kind, const struct DoublesAIContext *context);
+
+#endif
