+{
+    u8 target, move, bestMove = 0, bestTarget = gBattlerTarget;
+    s32 score, bestScore = -1;
+    u8 ties = 0;
+
+    if ((gBattleTypeFlags & (BATTLE_TYPE_TRAINER | BATTLE_TYPE_DOUBLE)) != (BATTLE_TYPE_TRAINER | BATTLE_TYPE_DOUBLE))
+        return ChooseMoveForTarget();
