+// Generated by scripts/balance_encounters.py.
+static bool8 IsPostgameWildLegend(u16 species)
+{
+    switch (species)
+    {
+    case SPECIES_ARTICUNO:
+    case SPECIES_ZAPDOS:
+    case SPECIES_MOLTRES:
+    case SPECIES_MEWTWO:
+    case SPECIES_MEW:
+    case SPECIES_RAIKOU:
+    case SPECIES_ENTEI:
+    case SPECIES_SUICUNE:
+    case SPECIES_LUGIA:
+    case SPECIES_HO_OH:
+    case SPECIES_CELEBI:
+    case SPECIES_REGIROCK:
+    case SPECIES_REGICE:
+    case SPECIES_REGISTEEL:
+    case SPECIES_LATIAS:
+    case SPECIES_LATIOS:
+    case SPECIES_KYOGRE:
+    case SPECIES_GROUDON:
+    case SPECIES_RAYQUAZA:
+    case SPECIES_JIRACHI:
+    case SPECIES_DEOXYS:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
