+void OpenTrainingMenu(void)
+{
+    if (!Training_IsUnlocked())
+    {
+        ScriptContext_Enable();
+        return;
+    }
+    CreateTask(Task_StartTraining, 10);
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+}
