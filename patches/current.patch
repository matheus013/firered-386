 static const u8 sUnownLetterSlots[][LAND_WILD_COUNT] = {
   //  A   A   A   A   A   A   A   A   A   A   A   ?
@@ -227,10 +229,22 @@ static void GenerateWildMon(u16 species, u8 level, u8 slot)
 {
     u32 personality;
     s8 chamber;
+    // Also protects older saves that reached a postgame map before the new gate.
+    if (IsPostgameWildLegend(species) && !FlagGet(FLAG_SYS_GAME_CLEAR))
+    {
+        species = SPECIES_ZUBAT;
+        level = 12;
+    }
+    species = Randomizer_Species(species);
     ZeroEnemyPartyMons();
-    if (species != SPECIES_UNOWN)
+    if (species != SPECIES_UNOWN || GameSettings_IsRandomizer())
