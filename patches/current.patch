+static const u8 sText_ReviewNormal[] = _("NORMAL\n\nSem regras de NUZLOCKE.\nTodas as melhorias da hackrom\ncontinuam disponiveis.\n\nA: confirmar  B: voltar");
+
+static void ShowGameModeChoices(u8 taskId)
+{
+    u8 window;
+    ClearWindowTilemap(sOakSpeechResources->windowIds[0]);
+    RemoveWindow(sOakSpeechResources->windowIds[0]);
+    window = AddWindow(&sGameModeWindow);
+    sOakSpeechResources->windowIds[0] = window;
+    TopBarWindowPrintTwoStrings(sText_ModeTitle, sText_ModePrompt, FALSE, 0, TRUE);
+    PutWindowTilemap(window);
+    FillWindowPixelBuffer(window, PIXEL_FILL(0));
+    AddTextPrinterParameterized4(window, FONT_NORMAL, 12, 2, 1, 1, sTextColor_White, 0, sText_ModeNormal);
+    AddTextPrinterParameterized4(window, FONT_NORMAL, 12, 18, 1, 1, sTextColor_White, 0, sText_ModeHardcore);
+    AddTextPrinterParameterized4(window, FONT_SMALL, 2, 48, 0, 0, sTextColor_White, 0, sText_ModeDescription);
+    Menu_InitCursor(window, FONT_NORMAL, 0, 2, 16, 2, 0);
+    CopyWindowToVram(window, COPYWIN_FULL);
+    gTasks[taskId].func = Task_ChooseGameMode;
+}
+
+static void Task_ChooseGameMode(u8 taskId)
+{
+    s8 input;
+    u8 window = sOakSpeechResources->windowIds[0];
+    if (gPaletteFade.active)
+        return;
+    input = Menu_ProcessInputNoWrapAround();
+    if (input < 0)
+        return;
+    gTasks[taskId].data[12] = input;
+    FillWindowPixelBuffer(window, PIXEL_FILL(0));
+    AddTextPrinterParameterized4(window, FONT_SMALL, 2, 0, 0, 0, sTextColor_White, 0,
+        input == GAME_MODE_HARDCORE ? sText_ReviewHardcore : sText_ReviewNormal);
+    CopyWindowToVram(window, COPYWIN_FULL);
+    gTasks[taskId].func = Task_ConfirmGameMode;
+}
+
+static void Task_ConfirmGameMode(u8 taskId)
+{
+    if (JOY_NEW(B_BUTTON))
+    {
+        ShowGameModeChoices(taskId);
+    }
+    else if (JOY_NEW(A_BUTTON))
+    {
+        Nuzlocke_ChooseMode(gTasks[taskId].data[12]);
+        ClearWindowTilemap(sOakSpeechResources->windowIds[0]);
+        RemoveWindow(sOakSpeechResources->windowIds[0]);
+        ControlsGuide_LoadPage1();
+        gTasks[taskId].func = Task_ControlsGuide_HandleInput;
+    }
+}
