diff --git a/src/doubles_ai.c b/src/doubles_ai.c
new file mode 100644
index 0000000..ac7b9de
--- /dev/null
+++ b/src/doubles_ai.c
@@ -0,0 +1,42 @@
+#include "doubles_ai.h"
+
+int DoublesAI_AdjustScore(int score, enum DoublesMoveKind kind, const struct DoublesAIContext *context)
+{
+    // A disabled move must never be resurrected by a support bonus.
+    if (score == 0)
+        return 0;
+
+    switch (kind)
+    {
+    case DOUBLES_MOVE_HELPING_HAND:
+        score += context->partnerAlive && context->partnerCanAttack ? 3 : -40;
+        break;
+    case DOUBLES_MOVE_SPREAD:
+        if (context->twoOpponents)
+            score += 2;
+        break;
+    case DOUBLES_MOVE_SPEED_CONTROL:
+        score += context->effectUseful ? 2 : -20;
+        break;
+    case DOUBLES_MOVE_SCREEN:
+        if (context->effectAlreadyActive)
+            score -= 40;
+        else if (context->partnerAlive)
+            score += 3;
+        break;
+    case DOUBLES_MOVE_WEATHER:
+        score += context->effectAlreadyActive ? -40 : context->effectUseful ? 3 : -15;
+        break;
+    case DOUBLES_MOVE_FRIENDLY_FIRE:
+        if (context->partnerAlive && !context->partnerImmune)
+            score -= 40;
+        break;
+    default:
+        break;
+    }
+    if (score < 0)
+        score = 0;
+    if (score > 255)
+        score = 255;
+    return score;
+}
diff --git a/src/elite_four.c b/src/elite_four.c
new file mode 100644
index 0000000..f2f05e6
--- /dev/null
+++ b/src/elite_four.c
@@ -0,0 +1,155 @@
+#include "global.h"
+#include "pokemon.h"
+#include "battle.h"
+#include "elite_four.h"
+#include "constants/opponents.h"
+#include "constants/pokemon.h"
+#include "constants/trainers.h"
+#include "constants/moves.h"
+
+bool8 EliteFour_IsChallenge(u16 trainer)
+{
+    u8 trainerClass = gTrainers[trainer].trainerClass;
+    if (trainerClass == TRAINER_CLASS_LEADER || trainerClass == TRAINER_CLASS_ELITE_FOUR
+        || trainerClass == TRAINER_CLASS_CHAMPION || trainerClass == TRAINER_CLASS_RIVAL_EARLY
+        || trainerClass == TRAINER_CLASS_RIVAL_LATE || trainerClass == TRAINER_CLASS_BOSS)
+        return TRUE;
+    switch (trainer)
+    {
+    case TRAINER_BLACK_BELT_KOICHI:
+    case TRAINER_BIKER_GOON: case TRAINER_BIKER_GOON_2: case TRAINER_BIKER_GOON_3:
+    case TRAINER_CUE_BALL_PAXTON:
+    case TRAINER_TEAM_ROCKET_ADMIN: case TRAINER_TEAM_ROCKET_ADMIN_2:
+    case TRAINER_SCIENTIST_GIDEON:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void ApplyRoleTraining(struct Pokemon *mon)
+{
+    u8 i,stat,evs[NUM_STATS] = {0};
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u16 physical = 0, special = 0, nature;
+    bool8 fast = gSpeciesInfo[species].baseSpeed >= 85 || species == SPECIES_SHEDINJA;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 move = GetMonData(mon, MON_DATA_MOVE1 + i);
+        // With six perfect IVs, generation III Hidden Power is always Dark/70.
+        if (move == MOVE_HIDDEN_POWER) { special += 70; continue; }
+        if (gBattleMoves[move].power <= 1) continue;
+        if (gBattleMoves[move].type < TYPE_MYSTERY) physical += gBattleMoves[move].power;
+        else special += gBattleMoves[move].power;
+    }
+    if (physical == 0 && special == 0)
+    {
+        evs[STAT_HP] = 252;
+        evs[STAT_DEF] = 128;
+        evs[STAT_SPDEF] = 128;
+        nature = 0xA500 | (gSpeciesInfo[species].baseDefense < gSpeciesInfo[species].baseSpDefense ? NATURE_BOLD : NATURE_CALM);
+        SetMonData(mon, MON_DATA_TRAINING_NATURE, &nature);
+        for (i = 0; i < NUM_STATS; i++) SetMonData(mon, MON_DATA_HP_EV + i, &evs[i]);
+        return;
+    }
+    if (physical == special)
+    {
+        physical = gSpeciesInfo[species].baseAttack;
+        special = gSpeciesInfo[species].baseSpAttack;
+    }
+    stat = physical > special ? STAT_ATK : STAT_SPATK;
+    evs[stat] = 252;
+    evs[fast ? STAT_SPEED : STAT_HP] = 252;
+    evs[species == SPECIES_SHEDINJA ? STAT_SPDEF : fast ? STAT_HP : STAT_DEF] = 4;
+    nature = 0xA500 | (stat == STAT_ATK ? (fast ? NATURE_JOLLY : NATURE_ADAMANT) : (fast ? NATURE_TIMID : NATURE_MODEST));
+    SetMonData(mon, MON_DATA_TRAINING_NATURE, &nature);
+    for (i = 0; i < NUM_STATS; i++) SetMonData(mon, MON_DATA_HP_EV + i, &evs[i]);
+}
+
+struct EliteFourTraining
+{
+    u16 species;
+    u8 nature;
+    u8 abilityNum;
+    u8 evs[NUM_STATS];
+};
+
+#include "data/elite_four_sets.h"
+
+static const struct EliteFourTraining *GetTraining(u16 trainer, u8 slot)
+{
+    u8 index;
+    if (slot >= PARTY_SIZE)
+        return NULL;
+    switch (trainer)
+    {
+    case TRAINER_ELITE_FOUR_LORELEI:
+    case TRAINER_ELITE_FOUR_LORELEI_2:
+        index = 0;
+        break;
+    case TRAINER_ELITE_FOUR_BRUNO:
+    case TRAINER_ELITE_FOUR_BRUNO_2:
+        index = 1;
+        break;
+    case TRAINER_ELITE_FOUR_AGATHA:
+    case TRAINER_ELITE_FOUR_AGATHA_2:
+        index = 2;
+        break;
+    case TRAINER_ELITE_FOUR_LANCE:
+    case TRAINER_ELITE_FOUR_LANCE_2:
+        index = 3;
+        break;
+    case TRAINER_CHAMPION_FIRST_SQUIRTLE:
+        return &sChampionTraining[0][slot];
+    case TRAINER_CHAMPION_FIRST_BULBASAUR:
+        return &sChampionTraining[1][slot];
+    case TRAINER_CHAMPION_FIRST_CHARMANDER:
+        return &sChampionTraining[2][slot];
+    case TRAINER_CHAMPION_REMATCH_SQUIRTLE:
+        return &sChampionRematchTraining[0][slot];
+    case TRAINER_CHAMPION_REMATCH_BULBASAUR:
+        return &sChampionRematchTraining[1][slot];
+    case TRAINER_CHAMPION_REMATCH_CHARMANDER:
+        return &sChampionRematchTraining[2][slot];
+    default:
+        return NULL;
+    }
+    return &sEliteFourTraining[index][slot];
+}
+
+u32 EliteFour_GetPersonality(u16 trainer, u8 slot, u32 personality)
+{
+    const struct EliteFourTraining *training = GetTraining(trainer, slot);
+    if (training != NULL)
+    {
+        // Nature and the ability slot share personality bits in this engine.
+        // At most 50 successive values are needed to satisfy both constraints.
+        while (personality % NUM_NATURES != training->nature
+            || (personality & 1) != training->abilityNum)
+            personality++;
+    }
+    return personality;
+}
+
+void EliteFour_ApplyTraining(struct Pokemon *mon, u16 trainer, u8 slot)
+{
+    const struct EliteFourTraining *training = GetTraining(trainer, slot);
+    u32 ivs = 0x3FFFFFFF;
+    u8 stat;
+    if (!EliteFour_IsChallenge(trainer))
+        return;
+    SetMonData(mon, MON_DATA_IVS, &ivs);
+    if (training != NULL && GetMonData(mon, MON_DATA_SPECIES) == training->species)
+        for (stat = 0; stat < NUM_STATS; stat++)
+            SetMonData(mon, MON_DATA_HP_EV + stat, &training->evs[stat]);
+    else
+        ApplyRoleTraining(mon);
+    CalculateMonStats(mon);
+}
+
+void EliteFour_ApplyFacilityTraining(struct Pokemon *mon)
+{
+    u32 ivs=0x3FFFFFFF;
+    SetMonData(mon,MON_DATA_IVS,&ivs);
+    ApplyRoleTraining(mon);
+    CalculateMonStats(mon);
+}
diff --git a/src/game_settings.c b/src/game_settings.c
new file mode 100644
index 0000000..f6ed494
--- /dev/null
+++ b/src/game_settings.c
@@ -0,0 +1,33 @@
+#include "global.h"
+#include "game_settings.h"
+#include "random.h"
+#define SETTINGS_MAGIC 0x31544553
+
+u8 GameSettings_GetLanguage(void)
+{
+    if (gSaveBlock2Ptr != NULL && gSaveBlock2Ptr->challenge.settingsMagic == SETTINGS_MAGIC
+        && gSaveBlock2Ptr->challenge.language == GAME_LANGUAGE_PTBR)
+        return GAME_LANGUAGE_PTBR;
+    return GAME_LANGUAGE_EN;
+}
+void GameSettings_SetLanguage(u8 language)
+{
+    if (gSaveBlock2Ptr->challenge.settingsMagic != SETTINGS_MAGIC)
+    {
+        gSaveBlock2Ptr->challenge.randomizer = FALSE;
+        gSaveBlock2Ptr->challenge.randomizerSeed = 0;
+    }
+    gSaveBlock2Ptr->challenge.settingsMagic = SETTINGS_MAGIC;
+    gSaveBlock2Ptr->challenge.language = language == GAME_LANGUAGE_PTBR ? GAME_LANGUAGE_PTBR : GAME_LANGUAGE_EN;
+}
+void GameSettings_ChooseRandomizer(bool8 enabled)
+{
+    GameSettings_SetLanguage(GameSettings_GetLanguage());
+    gSaveBlock2Ptr->challenge.randomizer = enabled != FALSE;
+    gSaveBlock2Ptr->challenge.randomizerSeed = enabled ? Random32() | 1 : 0;
+}
+bool8 GameSettings_IsRandomizer(void)
+{
+    return gSaveBlock2Ptr != NULL && gSaveBlock2Ptr->challenge.settingsMagic == SETTINGS_MAGIC
+        && gSaveBlock2Ptr->challenge.randomizer == TRUE && gSaveBlock2Ptr->challenge.randomizerSeed != 0;
+}
diff --git a/src/localization.c b/src/localization.c
new file mode 100644
index 0000000..4746f3b
--- /dev/null
+++ b/src/localization.c
@@ -0,0 +1,26 @@
+#include "global.h"
+#include "game_settings.h"
+#include "localization.h"
+#include "string_util.h"
+#include "characters.h"
+struct LocaleEntry { u32 hash; const u8 *en; const u8 *pt; };
+#include "data/localization_ptbr.h"
+const u8 *L10n_GetText(const u8 *source)
+{
+    u32 hash=2166136261u;
+    const u8 *cursor=source;
+    s32 low=0,high=ARRAY_COUNT(sPtLocale)-1,mid;
+    u16 length=0;
+    if(source==NULL || GameSettings_GetLanguage()!=GAME_LANGUAGE_PTBR)return source;
+    while(*cursor!=EOS && length<1000){hash=(hash^*cursor++)*16777619;length++;}
+    if(length==1000)return source;
+    while(low<=high)
+    {
+        mid=(low+high)/2;
+        if(sPtLocale[mid].hash<hash)low=mid+1;
+        else high=mid-1;
+    }
+    for(;low<ARRAY_COUNT(sPtLocale) && sPtLocale[low].hash==hash;low++)
+        if(StringCompare(source,sPtLocale[low].en)==0)return sPtLocale[low].pt;
+    return source;
+}
diff --git a/src/nuzlocke.c b/src/nuzlocke.c
new file mode 100644
index 0000000..c4e786d
--- /dev/null
+++ b/src/nuzlocke.c
@@ -0,0 +1,190 @@
+#include "global.h"
+#include "game_settings.h"
+#include "nuzlocke.h"
+#include "pokemon.h"
+#include "battle.h"
+#include "event_data.h"
+#include "item.h"
+#include "overworld.h"
+#include "pokedex.h"
+#include "constants/items.h"
+#include "constants/trainers.h"
+
+#define CHALLENGE_MAGIC 0x31435A4E // NZC1; old saves have no matching version tag.
+#define NUZLOCKE_DEAD_BIT 1 // Reserved BoxPokemon header bit; survives PC transfers.
+
+static EWRAM_DATA bool8 sCanCatch = TRUE;
+
+static bool8 IsPracticeBattle(void)
+{
+    return (gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_OLD_MAN_TUTORIAL
+        | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_TRAINER_TOWER | BATTLE_TYPE_BATTLE_TOWER)) != 0;
+}
+
+static bool8 IsPartyMon(struct Pokemon *mon)
+{
+    u8 i;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (mon == &gPlayerParty[i])
+            return TRUE;
+    return FALSE;
+}
+
+bool8 Nuzlocke_IsHardcore(void)
+{
+    return gSaveBlock2Ptr != NULL
+        && gSaveBlock2Ptr->challenge.magic == CHALLENGE_MAGIC
+        && gSaveBlock2Ptr->challenge.mode == GAME_MODE_HARDCORE;
+}
+
+void Nuzlocke_ChooseMode(u8 mode)
+{
+    u8 language = GameSettings_GetLanguage();
+    memset(&gSaveBlock2Ptr->challenge, 0, sizeof(gSaveBlock2Ptr->challenge));
+    GameSettings_SetLanguage(language);
+    gSaveBlock2Ptr->challenge.magic = CHALLENGE_MAGIC;
+    gSaveBlock2Ptr->challenge.mode = mode == GAME_MODE_HARDCORE ? GAME_MODE_HARDCORE : GAME_MODE_NORMAL;
+    if (Nuzlocke_IsHardcore())
+        gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SET;
+    sCanCatch = TRUE;
+}
+
+void Nuzlocke_Start(void)
+{
+    if (Nuzlocke_IsHardcore())
+        gSaveBlock2Ptr->challenge.started = TRUE;
+}
+
+bool8 Nuzlocke_IsActive(void)
+{
+    return Nuzlocke_IsHardcore() && gSaveBlock2Ptr->challenge.started;
+}
+
+void Nuzlocke_OnBattleStart(void)
+{
+    u8 area;
+    u16 species;
+    sCanCatch = TRUE;
+    if (!Nuzlocke_IsActive() || IsPracticeBattle() || (gBattleTypeFlags & BATTLE_TYPE_TRAINER)
+        // Both unidentified ghosts and the revealed Marowak reject all balls.
+        || (gBattleTypeFlags & BATTLE_TYPE_GHOST))
+        return;
+
+    sCanCatch = FALSE;
+    species = GetMonData(&gEnemyParty[0], MON_DATA_SPECIES);
+    // Already caught species do not consume a new area's eligible encounter.
+    if (species == SPECIES_NONE || GetSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_GET_CAUGHT))
+        return;
+
+    area = GetCurrentRegionMapSectionId();
+    if (!(gSaveBlock2Ptr->challenge.encounters[area / 8] & (1 << (area % 8))))
+    {
+        gSaveBlock2Ptr->challenge.encounters[area / 8] |= 1 << (area % 8);
+        sCanCatch = TRUE;
+    }
+}
+
+bool8 Nuzlocke_CanCatch(void)
+{
+    return !Nuzlocke_IsActive() || IsPracticeBattle() || sCanCatch;
+}
+
+bool8 Nuzlocke_CanUseBattleItem(u16 item)
+{
+    if (!Nuzlocke_IsHardcore() || IsPracticeBattle())
+        return TRUE;
+    return ItemId_GetPocket(item) == POCKET_POKE_BALLS && Nuzlocke_CanCatch();
+}
+
+bool8 Nuzlocke_IsDead(struct Pokemon *mon)
+{
+    return Nuzlocke_IsHardcore() && (mon->box.unused & NUZLOCKE_DEAD_BIT);
+}
+
+void Nuzlocke_MarkFainted(struct Pokemon *mon)
+{
+    if (!Nuzlocke_IsActive() || (gMain.inBattle && IsPracticeBattle())
+        || !GetMonData(mon, MON_DATA_SPECIES) || GetMonData(mon, MON_DATA_IS_EGG))
+        return;
+    mon->box.unused |= NUZLOCKE_DEAD_BIT;
+    mon->hp = 0;
+}
+
+static u8 GetTrainerLevel(u16 trainerId)
+{
+    const struct Trainer *trainer = &gTrainers[trainerId];
+    u8 i, level, highest = 1;
+    for (i = 0; i < trainer->partySize; i++)
+    {
+        switch (trainer->partyFlags)
+        {
+        case 0: level = trainer->party.NoItemDefaultMoves[i].lvl; break;
+        case F_TRAINER_PARTY_CUSTOM_MOVESET: level = trainer->party.NoItemCustomMoves[i].lvl; break;
+        case F_TRAINER_PARTY_HELD_ITEM: level = trainer->party.ItemDefaultMoves[i].lvl; break;
+        default: level = trainer->party.ItemCustomMoves[i].lvl; break;
+        }
+        if (level > highest)
+            highest = level;
+    }
+    return highest;
+}
+
+u8 Nuzlocke_GetLevelCap(void)
+{
+    static const u16 leaders[] = {TRAINER_LEADER_BROCK, TRAINER_LEADER_MISTY,
+        TRAINER_LEADER_LT_SURGE, TRAINER_LEADER_ERIKA, TRAINER_LEADER_KOGA,
+        TRAINER_LEADER_SABRINA, TRAINER_LEADER_BLAINE, TRAINER_LEADER_GIOVANNI};
+    u8 i;
+    if (FlagGet(FLAG_SYS_GAME_CLEAR))
+        return MAX_LEVEL;
+    for (i = 0; i < ARRAY_COUNT(leaders); i++)
+        if (!FlagGet(FLAG_BADGE01_GET + i))
+            return GetTrainerLevel(leaders[i]);
+    if (!FlagGet(FLAG_DEFEATED_LORELEI))
+        return GetTrainerLevel(TRAINER_ELITE_FOUR_LORELEI);
+    if (!FlagGet(FLAG_DEFEATED_BRUNO))
+        return GetTrainerLevel(TRAINER_ELITE_FOUR_BRUNO);
+    if (!FlagGet(FLAG_DEFEATED_AGATHA))
+        return GetTrainerLevel(TRAINER_ELITE_FOUR_AGATHA);
+    if (!FlagGet(FLAG_DEFEATED_LANCE))
+        return GetTrainerLevel(TRAINER_ELITE_FOUR_LANCE);
+    return GetTrainerLevel(TRAINER_CHAMPION_FIRST_SQUIRTLE);
+}
+
+bool8 Nuzlocke_IsOverCap(struct Pokemon *mon)
+{
+    return Nuzlocke_IsHardcore() && IsPartyMon(mon) && GetMonData(mon, MON_DATA_LEVEL) > Nuzlocke_GetLevelCap();
+}
+
+u32 Nuzlocke_ClampExperience(struct Pokemon *mon, u32 experience)
+{
+    // Generic creation/stat code also handles enemies and received over-level mons.
+    if (!IsPartyMon(mon))
+        return experience;
+    return Nuzlocke_ClampTrainingExperience(mon, experience);
+}
+
+u32 Nuzlocke_ClampTrainingExperience(struct Pokemon *mon, u32 experience)
+{
+    u16 species;
+    u8 cap;
+    u32 limit, current;
+    current = GetMonData(mon, MON_DATA_EXP);
+    if (Nuzlocke_IsDead(mon))
+        return current;
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    cap = Nuzlocke_GetLevelCap();
+    if (!species || cap == MAX_LEVEL)
+        return experience;
+    limit = gExperienceTables[gSpeciesInfo[species].growthRate][cap + 1] - 1;
+    // An acquired over-level mon keeps its level, but cannot gain more EXP.
+    if (current > limit)
+        limit = current;
+    return experience > limit ? limit : experience;
+}
+
+u16 Nuzlocke_LimitExpGain(struct Pokemon *mon, u32 gain)
+{
+    u32 current = GetMonData(mon, MON_DATA_EXP);
+    return Nuzlocke_ClampExperience(mon, current + gain) - current;
+}
