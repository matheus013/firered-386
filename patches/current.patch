+    if (gPaletteFade.active)
+        return;
+    input = Menu_ProcessInputNoWrapAround();
+    if (input < 0)
+        return;
+    gTasks[taskId].data[12] = input;
+    FillWindowPixelBuffer(window, PIXEL_FILL(0));
+    AddTextPrinterParameterized4(window, FONT_SMALL, 2, 0, 0, 0, sTextColor_White, 0,
+        input == GAME_MODE_HARDCORE ? sText_ReviewHardcore : sText_ReviewNormal);
