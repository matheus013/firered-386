+static void PrintAt(u8 x,u8 y,u8 background,u8 foreground,const u8 *text)
+{
+    u8 colors[3];
+    colors[0]=background;colors[1]=foreground;colors[2]=background;
+    AddTextPrinterParameterized4(0,FONT_SMALL,x,y,0,0,colors,0,text);
