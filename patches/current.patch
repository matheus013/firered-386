+         || (gAbsentBattlerFlags & gBitTable[target]) || gBattleMons[target].hp == 0)
+            continue;
+        BattleAI_SetupAIData();
+        gBattlerTarget = target;
+        move = ChooseMoveForTarget();
+        if (move >= MAX_MON_MOVES)
+            return move;
+        score = AI_THINKING_STRUCT->score[move];
+        if (score > bestScore)
+        {
+            bestScore = score;
+            bestMove = move;
+            bestTarget = target;
+            ties = 1;
+        }
+        else if (score == bestScore && Random() % ++ties == 0)
+        {
+            bestMove = move;
+            bestTarget = target;
+        }
+    }
+    gBattlerTarget = bestTarget;
+    return bestMove;
+}
