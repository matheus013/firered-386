+// Keep translated descriptions inside the 120px left pane. The original text
+// printer does not clip long lines and can overwrite the adjacent move window.
+static const u8 sDescriptionSpace[] = {CHAR_SPACE, EOS};
+static u8 PokeSum_FormatMoveDescription(u16 move, bool8 draw)
+{
+    const u8 *source;
+    u8 line[96], word[64], candidate[160];
+    u8 lines = 0, n;
+    if (move == MOVE_NONE || move >= MOVES_COUNT) return 0;
+    source = L10n_GetText(gMoveDescriptionPointers[move - 1]);
+    line[0] = EOS;
+    while (*source != EOS)
+    {
+        while (*source == CHAR_SPACE || *source == CHAR_NEWLINE) source++;
+        if (*source == EOS) break;
+        n = 0;
+        while (*source != EOS && *source != CHAR_SPACE && *source != CHAR_NEWLINE)
+        {
+            if (n < sizeof(word) - 1) word[n++] = *source;
+            source++;
+        }
+        word[n] = EOS;
+        StringCopy(candidate, line);
+        if (line[0] != EOS) StringAppend(candidate, sDescriptionSpace);
+        StringAppend(candidate, word);
+        if (line[0] != EOS && (StringLength(candidate) >= sizeof(line) || GetStringWidth(FONT_SMALL, candidate, 0) > 106))
+        {
+            if (draw && lines < 5)
+                AddTextPrinterParameterized3(sMonSummaryScreen->windowIds[POKESUM_WIN_TRAINER_MEMO], FONT_SMALL,
+                                             7, 42 + lines * 12, sLevelNickTextColors[0], TEXT_SKIP_DRAW, line);
+            lines++;
+            StringCopy(line, word);
+        }
+        else StringCopy(line, candidate);
+    }
+    if (line[0] != EOS)
+    {
+        if (draw && lines < 5)
+            AddTextPrinterParameterized3(sMonSummaryScreen->windowIds[POKESUM_WIN_TRAINER_MEMO], FONT_SMALL,
+                                         7, 42 + lines * 12, sLevelNickTextColors[0], TEXT_SKIP_DRAW, line);
+        lines++;
+    }
+    return lines;
+}
+
